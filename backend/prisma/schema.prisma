generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id        Int      @id @default(autoincrement())
  name      String
  bio       String?
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 
}

model Work {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  imageUrls   String[] @default([])
  place       String?
  year        Int?
  material    String?
  dimensions  String?
  mediums     String[] @default([])
  eventName   String?
  theme       String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  
}
